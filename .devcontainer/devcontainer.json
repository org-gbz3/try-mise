{
  "name": "try-mise",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "runServices": ["dev", "sqlserver"],
  "workspaceFolder": "/workspaces/try-mise",
  "remoteUser": "vscode",
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": { "label": "SvelteKit" },
    "5000": { "label": "ASP.NET Core" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "ms-dotnettools.csharp",
        "esbenp.prettier-vscode",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },
  "shutdownAction": "stopCompose",
  "postCreateCommand": "mise trust /workspaces/try-mise/mise.toml"
}
